function pfind --description 'Interactive file search with pattern matching and clipboard copy'
    # Check dependencies
    if not command -v rg &>/dev/null
        gum style --foreground 196 "✗ Error: ripgrep (rg) is required"
        echo "Install: cargo install ripgrep or use your package manager"
        return 1
    end

    if not command -v fd &>/dev/null
        gum style --foreground 196 "✗ Error: fd is required"
        echo "Install: cargo install fd-find or use your package manager"
        return 1
    end

    if not command -v gum &>/dev/null
        echo "✗ Error: gum is required"
        echo "Install: https://github.com/charmbracelet/gum"
        return 1
    end

    if not command -v wl-copy &>/dev/null
        gum style --foreground 196 "✗ Error: wl-copy (wl-clipboard) is required"
        return 1
    end

    # State variables
    set -l search_mode "content"  # content or names
    set -l path_mode "relative"   # relative or absolute
    set -l action_mode "copy"     # copy or open

    # Header
    gum style \
        --border double \
        --border-foreground 212 \
        --padding "1 2" \
        --margin "1" \
        "📁 Interactive File Search" \
        "Search → Select → Copy or Open" \
        "" \
        "Commands: :m (mode) :p (path) :a (action) :h (help) :q (quit)"

    echo ""

    while true
        # Build status indicator
        set -l search_icon "📄"
        set -l search_label "content"
        set -l search_detail "(shows matching lines)"
        if test "$search_mode" = "names"
            set search_icon "📁"
            set search_label "names"
            set search_detail "(shows files/folders)"
        end

        set -l path_icon "📍"
        if test "$path_mode" = "absolute"
            set path_icon "🌐"
        end

        set -l action_icon "📋"
        set -l action_label "copy"
        if test "$action_mode" = "open"
            set action_icon "📂"
            set action_label "open"
        end

        # Show current mode
        gum style --foreground 86 "$search_icon Search: $search_label $search_detail | $path_icon Path: $path_mode | $action_icon Action: $action_label"

        # Get search pattern
        set -l pattern (gum input \
            --placeholder "Enter pattern or command (:m :p :a :h :q)..." \
            --prompt "🔍 " \
            --width 60)

        # Exit if cancelled
        if test $status -ne 0
            echo ""
            gum style --foreground 214 "👋 Goodbye!"
            break
        end

        # Handle commands
        switch "$pattern"
            case ""
                echo ""
                gum style --foreground 214 "👋 Goodbye!"
                break

            case ":m" ":mode"
                # Toggle search mode
                if test "$search_mode" = "content"
                    set search_mode "names"
                    gum style --foreground 82 --bold "→ Switched to: Search file/folder names"
                else
                    set search_mode "content"
                    gum style --foreground 82 --bold "→ Switched to: Search file contents (with line context)"
                end
                echo ""
                continue

            case ":p" ":path"
                # Toggle path mode
                if test "$path_mode" = "relative"
                    set path_mode "absolute"
                    gum style --foreground 82 --bold "→ Switched to: Copy absolute paths"
                else
                    set path_mode "relative"
                    gum style --foreground 82 --bold "→ Switched to: Copy relative paths"
                end
                echo ""
                continue

            case ":a" ":action"
                # Toggle action mode
                if test "$action_mode" = "copy"
                    set action_mode "open"
                    gum style --foreground 82 --bold "→ Switched to: Open in \$EDITOR"
                else
                    set action_mode "copy"
                    gum style --foreground 82 --bold "→ Switched to: Copy to clipboard"
                end
                echo ""
                continue

            case ":h" ":help"
                # Show help
                gum style \
                    --border normal \
                    --border-foreground 86 \
                    --padding "1 2" \
                    "📖 Help" \
                    "" \
                    "Search Modes:" \
                    "  content  - Search within file contents (ripgrep)" \
                    "             Shows: filename:line:matching_content" \
                    "             Copies: filename:line (editor-friendly)" \
                    "  names    - Search file/folder names (fd)" \
                    "             Shows: filename" \
                    "             Copies: filename" \
                    "" \
                    "Path Modes:" \
                    "  relative - Use relative path from current directory" \
                    "  absolute - Use full absolute path" \
                    "" \
                    "Action Modes:" \
                    "  copy     - Copy path to clipboard (default)" \
                    "  open     - Open file in \$EDITOR" \
                    "" \
                    "Commands:" \
                    "  :m       - Toggle search mode (content ↔ names)" \
                    "  :p       - Toggle path mode (relative ↔ absolute)" \
                    "  :a       - Toggle action mode (copy ↔ open)" \
                    "  :h       - Show this help" \
                    "  :q       - Quit (or empty pattern / Ctrl+C)" \
                    "" \
                    "Workflow:" \
                    "  1. Enter search pattern" \
                    "  2. Select match from fuzzy list (Esc to cancel)" \
                    "  3. Path (with line number in content mode) copied to clipboard" \
                    "" \
                    "Examples:" \
                    "  content mode: copies 'src/main.rs:42'" \
                    "  names mode:   copies 'src/main.rs'"
                echo ""
                continue

            case ":q" ":quit" ":exit"
                echo ""
                gum style --foreground 214 "👋 Goodbye!"
                break
        end

        # Search based on mode
        set -l results
        set -l has_line_numbers 0

        if test "$search_mode" = "content"
            # Search file contents with ripgrep, show each matching line
            # Format: filename:line_number:matching_content
            # --color=always highlights the matching pattern
            set results (rg -n --no-heading --hidden --glob '!.git/' --color=always "$pattern" 2>/dev/null)
            set has_line_numbers 1
        else
            # Search file/folder names with fd
            set results (fd --hidden --exclude .git --type f --type d --color=always "$pattern" 2>/dev/null)
        end

        # Check results
        if test (count $results) -eq 0
            gum style \
                --foreground 196 \
                --bold \
                "✗ No results found for '$pattern'"
            echo ""
            continue
        end

        # Show count
        set -l count (count $results)
        if test $count -eq 1
            gum style --foreground 86 --bold "✓ Found 1 result"
        else
            gum style --foreground 86 --bold "✓ Found $count results"
        end
        echo ""

        # Let user select with filter (substring matching, not character-by-character fuzzy)
        set -l selected (printf '%s\n' $results | gum filter \
            --placeholder "Filter results (substring match, Esc to search again)..." \
            --height 15 \
            --fuzzy=false \
            --prompt "→ ")

        # Handle selection
        if test $status -ne 0
            # User cancelled (Esc)
            gum style --foreground 214 "⏭  Cancelled, back to search"
            echo ""
            continue
        end

        if test -z "$selected"
            gum style --foreground 214 "⏭  No selection, back to search"
            echo ""
            continue
        end

        # Parse the selection
        set -l copy_path "$selected"
        set -l line_num ""

        if test $has_line_numbers -eq 1
            # Parse filename:line:content format
            # Split on first two colons only (content might have colons)
            set -l parts (string split -m 2 ":" "$selected")
            if test (count $parts) -ge 2
                set copy_path $parts[1]
                set line_num $parts[2]
            end
        end

        # Convert to absolute path if needed
        if test "$path_mode" = "absolute"
            if test -e "$copy_path"
                set copy_path (realpath "$copy_path")
            end
        end

        # Perform action based on mode
        if test "$action_mode" = "open"
            # Open in editor
            if not set -q EDITOR
                gum style --foreground 196 "✗ Error: \$EDITOR not set"
                echo ""
                continue
            end

            if test -n "$line_num"
                # Open at specific line (works with vim, nvim, nano, emacs, etc.)
                $EDITOR +$line_num $copy_path &
            else
                # Just open file
                $EDITOR $copy_path &
            end

            gum style \
                --foreground 82 \
                --bold \
                "✓ Opened in \$EDITOR: $copy_path"
            if test -n "$line_num"
                gum style --foreground 86 "  (at line $line_num)"
            end
            echo ""
        else
            # Copy to clipboard
            # Append line number if available (for editor jumping)
            if test -n "$line_num"
                set copy_path "$copy_path:$line_num"
            end

            echo -n $copy_path | wl-copy
            gum style \
                --foreground 82 \
                --bold \
                "✓ Copied to clipboard: $copy_path"
            echo ""
        end
    end
end
