{
  "mcpServers": {
    "terraform": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "TFE_ADDRESS=https://app.terraform.io",
        "-e",
        "TFE_TOKEN={{ tfe_token }}",
        "hashicorp/terraform-mcp-server"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "kong-docs": {
      "command": "/home/dustin/.local/share/kong-docs-rag-venv/bin/python3",
      "args": [
        "/home/dustin/dev/kong/docs-rag/query_kong_docs_mcp.py"
      ],
      "env": {
        "WEAVIATE_URL": "http://localhost:8080"
      }
    }
  }
}
