{
  "mcpServers": {
    "terraform": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "TFE_ADDRESS=https://app.terraform.io",
        "-e",
        "TFE_TOKEN={{ tfe_token }}",
        "hashicorp/terraform-mcp-server"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "kong-docs": {
      "command": "npx",
      "args": [
        "@qdrant/mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "file://{{ user.home }}/dev/kong/docs-rag/vector-db",
        "COLLECTION_NAME": "kong-docs"
      }
    }
  }
}
