    // {
    //     input_extensions: [ "json" ]
    //     output_extension: json
    //     mode: text
    //     command: [ "jq" ]
    // }
]

###############################################################
# Imports
# Split configuration into multiple files
# Import different skins based on terminal luma (light/dark)
imports: [
    # Verbs are configured in verbs.hjson
    verbs.hjson

    # Dark terminal skin
    {
        luma: [
            dark
            unknown
        ]
        file: skins/dark-blue.hjson
    }

    # Light terminal skin
    {
        luma: light
        file: skins/white.hjson
    }
]
