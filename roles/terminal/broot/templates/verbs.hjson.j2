###############################################################
# Broot verbs configuration
# Managed by Ansible - changes may be overwritten
#
# Documentation at https://dystroy.org/broot/verbs/
###############################################################

verbs: [

    ###########################################################
    # Editor integration - VSCode
    # Press 'e' to open files in VSCode
    {
        invocation: edit
        shortcut: e
        apply_to: text_file
        execution: "code {file}"
        leave_broot: false
    }

    ###########################################################
    # Open with system default (xdg-open)
    # Press Enter to open any file with default application
    {
        invocation: open
        key: enter
        execution: "xdg-open {file}"
        leave_broot: false
    }

    ###########################################################
    # Create new file
    # Convenient shortcut to create files in current/sub directory
    {
        invocation: "create {subpath}"
        execution: "code {directory}/{subpath}"
        leave_broot: false
    }

    ###########################################################
    # Git diff
    # Quick git diff on selected file
    {
        invocation: git_diff
        shortcut: gd
        execution: "git difftool -y {file}"
        leave_broot: false
    }

    ###########################################################
    # Backup file/directory
    # Create versioned backup copy
    {
        invocation: "backup {version}"
        key: ctrl-b
        auto_exec: false
        execution: "cp -r {file} {parent}/{file-stem}-{version}{file-dot-extension}"
        leave_broot: false
    }

    ###########################################################
    # Terminal
    # Launch shell in current directory
    {
        invocation: terminal
        key: ctrl-t
        execution: "$SHELL"
        set_working_dir: true
        leave_broot: false
    }

    ###########################################################
    # Optional: Use system trash instead of rm
    # Uncomment to make rm use trash
    # {
    #     invocation: "rm"
    #     internal: "trash"
    #     leave_broot: false
    # }

    ###########################################################
    # Optional: Vim-style navigation
    # Uncomment for ctrl-j/k/u/d navigation
    # {
    #     key: ctrl-k
    #     execution: ":line_up"
    # }
    # {
    #     key: ctrl-j
    #     execution: ":line_down"
    # }
    # {
    #     key: ctrl-u
    #     execution: ":page_up"
    # }
    # {
    #     key: ctrl-d
    #     execution: ":page_down"
    # }

    ###########################################################
    # Optional: Quick git status toggle
    # {
    #     key: alt-g
    #     execution: ":toggle_git_status"
    # }

    ###########################################################
    # Optional: Norton Commander style copy/move
    # {
    #     key: F5
    #     external: "cp -r {file} {other-panel-directory}"
    #     leave_broot: false
    # }
    # {
    #     key: F6
    #     external: "mv {file} {other-panel-directory}"
    #     leave_broot: false
    # }

    ###########################################################
    # Optional: Go to git repository root
    # {
    #     invocation: gtr
    #     execution: ":focus {git-root}"
    # }

    ###########################################################
    # Optional: Go to home directory
    # {
    #     invocation: home
    #     key: ctrl-home
    #     execution: ":focus ~"
    # }

    ###########################################################
    # Optional: Copy all children to destination
    # Requires from_shell for wildcard expansion
    # {
    #     invocation: "cpa {dest}"
    #     external: "cp -r {directory}/* {dest}"
    #     from_shell: true
    # }

]
